# Discord Bot
DISCORD_TOKEN=

# Anthropic API
ANTHROPIC_API_KEY=

# 対象サーバー(Guild) ID
GUILD_ID=

# メッセージ履歴・アクティブユーザー集計の対象チャンネルID（カンマ区切り）
TARGET_CHANNEL_IDS=

# 自己紹介チャンネルID（TARGET_CHANNEL_IDS に含めても含めなくてもよい）
INTRO_CHANNEL_ID=

# 集計対象のタイムゾーン（IANA名）
TIMEZONE=Asia/Tokyo

# 使用モデル
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-5

# 出力先ディレクトリ
OUTPUT_DIR=reports
METRICS_CSV_PATH=metrics_history.csv
METRICS_GRAPH_PATH=metrics_graph.png
