# Discord Bot
DISCORD_TOKEN=

# Anthropic API
ANTHROPIC_API_KEY=

# 対象サーバー(Guild) ID
GUILD_ID=1504714750557294682

# 集計から除外したいチャンネルID（カンマ区切り、運営専用チャンネルなど）
EXCLUDE_CHANNEL_IDS=

# 自己紹介チャンネルID
INTRO_CHANNEL_ID=1509451256962486385

# 自己紹介の投稿から自動付与される「閲覧権限」ロール名（ダッシュボードでは DHUmember 数として扱う）
VIEW_ROLE_NAME=閲覧権限

# 運営（管理者）ロール名
ADMIN_ROLE_NAME=Administrator

# 「チャンネルの盛り上がり」から除外するチャンネル名キーワード（カンマ区切り、部分一致）
RANKING_EXCLUDE_KEYWORDS=ようこそ,自己紹介,アナウンス

# 集計対象のタイムゾーン（IANA名）
TIMEZONE=Asia/Tokyo

# 使用モデル
HAIKU_MODEL=claude-haiku-4-5-20251001
SONNET_MODEL=claude-sonnet-5

# 出力先
METRICS_CSV_PATH=metrics_history.csv
METRICS_GRAPH_PATH=metrics_graph.png
ACTIVITY_GRAPH_PATH=activity_graph.png
ACTIVITY_CSV_PATH=activity_history.csv

# ダッシュボード閲覧パスワード（設定するとdocs/data.jsonの代わりに
# 暗号化データ docs/data.enc のみを配信する）
DASHBOARD_PASSWORD=
